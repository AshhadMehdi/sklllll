# ── Qareeb API server ─────────────────────────────────────────────────────────
# Copy to server/.env (or set as real environment variables in production).

NODE_ENV=development
PORT=4000
APP_NAME=Qareeb

# REQUIRED in production – sign JWTs with a long random string
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# SQLite file (default: server/data/qareeb.db). Also accepts a Turso/libSQL URL.
# DATABASE_URL=file:./data/qareeb.db
# DATABASE_AUTH_TOKEN=

# Where uploaded product/shop photos are stored (default: server/uploads)
# UPLOADS_DIR=

# Extra allowed browser origins (comma separated). Same-origin + localhost are always allowed.
# CORS_ORIGINS=https://qareeb.example.com

# Google Sign-In (optional). Must match VITE_GOOGLE_CLIENT_ID on the client.
# GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Web Push (optional). If omitted, a key pair is generated once and cached in server/.vapid.json
# VAPID_SUBJECT=mailto:support@qareeb.app
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# Seed demo data (Abbottabad shops, users, orders) into an empty database on boot
AUTO_SEED=true
DEMO_PASSWORD=password123
