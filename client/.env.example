# ── Qareeb web app ────────────────────────────────────────────────────────────
# Copy to client/.env.local. All variables are optional.
# (Google Sign-In is configured on the server via GOOGLE_CLIENT_ID and delivered through /api/config.)

# Production only: origin of the API when the frontend is deployed on its own host (Vercel/Netlify).
# Leave unset when the Node server serves the built client (Render/Railway/Docker) – same origin.
# VITE_API_URL=https://qareeb-api.onrender.com

# Where the Vite dev server proxies /api, /uploads and /socket.io (default http://localhost:4000)
# VITE_API_PROXY=http://localhost:4000

# When the dev server sits behind an HTTPS reverse proxy (e.g. a cloud preview), set the public port for HMR
# HMR_CLIENT_PORT=443
